# Copy to .env and fill in. Loaded via python-dotenv at startup.

# Free to request at semanticscholar.org/product/api. Tool works without it
# (slower, unauthenticated tier) but a key is strongly recommended before any
# real-volume run (SRS NFR-1 / Section 7.3).
S2_API_KEY=

# OpenAlex asks for a contact email to route you into its faster "polite pool".
# Optional but recommended.
OPENALEX_CONTACT_EMAIL=

# --- Optional: API victim models for the AgentDojo transfer harness ---
# The harness defaults to a local vLLM server (--models local). Open 7B-14B
# models have not reached a readable attack control on these suites; an API
# model is the documented fallback. AgentDojo reads these via the standard
# SDK env vars, so only the one you intend to use is needed.
#
# Cost is real: one calibration sweep is ~64 agent runs, each several
# tool-calling turns. Start with the smallest suite and n_user/n_inject.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
