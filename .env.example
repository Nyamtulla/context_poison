# Copy to .env and fill in. Loaded via python-dotenv at startup.

# Free to request at semanticscholar.org/product/api. Tool works without it
# (slower, unauthenticated tier) but a key is strongly recommended before any
# real-volume run (SRS NFR-1 / Section 7.3).
S2_API_KEY=

# OpenAlex asks for a contact email to route you into its faster "polite pool".
# Optional but recommended.
OPENALEX_CONTACT_EMAIL=
